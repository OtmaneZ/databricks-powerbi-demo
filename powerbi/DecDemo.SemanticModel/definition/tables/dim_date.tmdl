/// Calendrier continu du 1er novembre 2024 au 31 décembre 2026 (gold.dim_date), marqué comme table de dates.
table dim_date
	dataCategory: Time

	/// Jour calendaire. Clé de la table de dates.
	column calendar_date
		dataType: dateTime
		isKey
		formatString: dd/MM/yyyy
		summarizeBy: none
		sourceColumn: calendar_date

	/// Année civile.
	column year
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: year

	/// Trimestre civil, de 1 à 4.
	column quarter
		dataType: int64
		formatString: 0
		summarizeBy: none
		sourceColumn: quarter

	/// Numéro du mois, de 1 à 12 ; sert au tri des noms de mois.
	column month
		dataType: int64
		isHidden
		formatString: 0
		summarizeBy: none
		sourceColumn: month

	/// Nom du mois en français, trié dans l'ordre du calendrier.
	column month_name
		dataType: string
		summarizeBy: none
		sourceColumn: month_name
		sortByColumn: month

	/// Année-mois au format AAAA-MM ; l'ordre alphabétique suit le calendrier.
	column year_month
		dataType: string
		summarizeBy: none
		sourceColumn: year_month

	partition dim_date = m
		mode: import
		source =
				let
					Source = Parquet.Document(File.Contents(DossierDonnees & "dim_date.parquet")),
					#"Colonnes sélectionnées" = Table.SelectColumns(Source, {"calendar_date", "year", "quarter", "month", "month_name", "year_month"}),
					#"Types appliqués" = Table.TransformColumnTypes(#"Colonnes sélectionnées", {{"calendar_date", type date}, {"year", Int64.Type}, {"quarter", Int64.Type}, {"month", Int64.Type}, {"month_name", type text}, {"year_month", type text}})
				in
					#"Types appliqués"
