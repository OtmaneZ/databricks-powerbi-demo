        ROW("N°", 378, "Obtenu", CALCULATE([Titre produits en rupture], dim_date[year] = 2026)),
        ROW("N°", 379, "Obtenu", CALCULATE([Titre qualité], dim_date[year] = 2026)),
        ROW("N°", 380, "Obtenu", CALCULATE([Titre quarantaine mensuelle], dim_date[year] = 2026)),
        ROW("N°", 381, "Obtenu", CALCULATE([Titre quarantaine par motif], dim_date[year] = 2026)),
        ROW("N°", 382, "Obtenu", CALCULATE([Titre rejet par région], dim_date[year] = 2026)),
        ROW("N°", 383, "Obtenu", CALCULATE([Titre ruptures par région], dim_date[year] = 2026)),
        ROW("N°", 384, "Obtenu", CALCULATE([Titre ventes], dim_date[year] = 2026)),
        ROW("N°", 385, "Obtenu", CALCULATE([Titre évolution par famille], dim_date[year] = 2026)),
        ROW("N°", 386, "Obtenu", CALCULATE([Titre évolution par région], dim_date[year] = 2026))
        )
    VAR _resultatsNombres =
        ADDCOLUMNS(
            _attendusNombres,
            "Obtenu",
                VAR _cle = [Clé]
                RETURN MAXX(FILTER(_obtenusNombres, [N°] = _cle), [Obtenu])
        )
    VAR _controlesNombres =
        SELECTCOLUMNS(
            _resultatsNombres,
            "Cas", [Cas],
            "Mesure", [Mesure],
            "Attendu", IF([Vide], "(vide)", FORMAT([Attendu], "0.0000", "fr-FR")),
            "Obtenu", IF(ISBLANK([Obtenu]), "(vide)", FORMAT([Obtenu], "0.0000", "fr-FR")),
            "Écart", IF([Vide] || ISBLANK([Obtenu]), BLANK(), [Obtenu] - [Attendu]),
            "Statut",
                IF(
                    [Vide],
                    IF(ISBLANK([Obtenu]), "OK", "KO"),
                    IF(
                        NOT ISBLANK([Obtenu]) && ABS([Obtenu] - [Attendu]) <= [Tolérance],
                        "OK",
                        "KO"
                    )
                )
        )
    VAR _controlesTextes =
        SELECTCOLUMNS(
            ADDCOLUMNS(
                _attendusTextes,
                "Obtenu",
                    VAR _cle = [Clé]
                    VAR _texte = MAXX(FILTER(_obtenusTextes, [N°] = _cle), [Obtenu])
                    VAR _sansInsecables = SUBSTITUTE(_texte & "", UNICHAR(160), " ")
                    RETURN SUBSTITUTE(_sansInsecables, UNICHAR(8239), " ")
            ),
            "Cas", [Cas],
            "Mesure", [Mesure],
            "Attendu", [Attendu],
            "Obtenu", [Obtenu],
            "Écart", BLANK(),
            "Statut", IF(EXACT([Obtenu], [Attendu]), "OK", "KO")
        )
    VAR _controles = UNION(_controlesNombres, _controlesTextes)

EVALUATE
    ROW(
        "Contrôles", COUNTROWS(_controles),
        "KO", COUNTROWS(FILTER(_controles, [Statut] = "KO")) + 0
    )

EVALUATE
    _controles
    ORDER BY [Statut] ASC, [Cas] ASC, [Mesure] ASC
